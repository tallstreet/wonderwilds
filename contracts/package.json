{
  "name": "wonderwilds-contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node check.ts",
    "typecheck": "tsc --noEmit --strict --target es2022 --module nodenext check.ts generated/contracts.ts --types node",
    "generate": "python3 ../scripts/generate-contracts.py",
    "check:generated": "python3 ../scripts/generate-contracts.py --check"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.5"
  }
}
